{
  "name": "claude-in-editor",
  "displayName": "Claude Terminal in Editor",
  "description": "Open a terminal as a main editor tab with a sidebar icon or keyboard shortcut",
  "version": "0.0.1",
  "publisher": "brett-pappas",
  "repository": {
    "type": "git",
    "url": "https://github.com/brettpappas/terminal-in-editor"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Claude Terminal",
      "properties": {
        "terminalInEditor.command": {
          "type": "string",
          "default": "claude",
          "description": "Optional command to run automatically when the terminal opens. Leave blank for a plain shell."
        },
        "terminalInEditor.name": {
          "type": "string",
          "default": "Claude Terminal",
          "description": "Display name for the terminal tab."
        }
      }
    },
    "commands": [
      {
        "command": "terminalInEditor.open",
        "title": "Open Terminal in Editor Tab",
        "icon": "$(terminal)"
      }
    ],
    "keybindings": [
      {
        "command": "terminalInEditor.open",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claude-in-editor-container",
          "title": "Claude Terminal in Editor",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "claude-in-editor-container": [
        {
          "id": "terminalInEditor.sidebarView",
          "name": "Claude Terminal",
          "type": "tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "terminalInEditor.sidebarView",
        "contents": "Open a terminal as an editor tab.\n\n[$(terminal) Open Claude Terminal in Editor](command:terminalInEditor.open)\n\nOr use the keyboard shortcut:\n**Ctrl+Alt+T** (Cmd+Alt+T on Mac)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "terminalInEditor.open",
          "when": "view == terminalInEditor.sidebarView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^18.x",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.x"
  }
}